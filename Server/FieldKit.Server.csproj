<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>FieldKit.Server</AssemblyName>
    <RootNamespace>FieldKit.Server</RootNamespace>
    <Version>1.4.0</Version>
    <OutputPath>bin\$(Configuration)\FieldKit.Server\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The ZIP is a build output that Visual Studio's fast check cannot
         track, so always let MSBuild evaluate the packaging target. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <FieldKitForceRebuildDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)</FieldKitForceRebuildDir>
    <FieldKitForceRebuildFile>$(FieldKitForceRebuildDir)\FieldKit.Server.ForceRebuild.g.cs</FieldKitForceRebuildFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\.build\**</DefaultItemExcludes>
    <SptRoot Condition="'$(SptRoot)' == ''">C:\SPT\4.1.1</SptRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(FieldKitForceRebuildFile)"
             AutoGen="true"
             DesignTime="false"
             Visible="false" />
    <ProjectReference Include="..\Client\FieldKit.Client.csproj"
                      ReferenceOutputAssembly="false" />
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRoot)\SPT_Runtime\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\SPT_Runtime\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Assets">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Server.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Web">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Server.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <FieldKitServerInstallDir>$(SptRoot)\SPT_Runtime\user\mods\HysocsFieldKit</FieldKitServerInstallDir>
    <FieldKitClientDll>$(MSBuildProjectDirectory)\..\Client\bin\$(Configuration)\netstandard2.1\FieldKit.dll</FieldKitClientDll>
    <FieldKitLicense>$(MSBuildProjectDirectory)\..\LICENSE</FieldKitLicense>
    <FieldKitPackageRoot>$(MSBuildProjectDirectory)\..\dist\FieldKit-$(Version)</FieldKitPackageRoot>
    <FieldKitPackageZip>$(MSBuildProjectDirectory)\..\dist\FieldKit-$(Version).zip</FieldKitPackageZip>
  </PropertyGroup>

  <Target Name="DeployFieldKitServerMod"
          AfterTargets="Build"
          Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(FieldKitServerInstallDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(FieldKitServerInstallDir)"
          SkipUnchangedFiles="false" />
    <Message Importance="high"
             Text="FieldKit server mod deployed: $(FieldKitServerInstallDir)\$(TargetFileName)" />
  </Target>

  <Target Name="ForceFieldKitServerRebuild"
          BeforeTargets="CoreCompile"
          Condition="'$(SkipForceRebuild)' != 'true'">
    <MakeDir Directories="$(FieldKitForceRebuildDir)" />
    <Touch Files="$(FieldKitForceRebuildFile)"
           AlwaysCreate="true"
           ForceTouch="true" />
  </Target>

  <Target Name="CreateFieldKitReleasePackage"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(FieldKitPackageRoot)" />
    <Delete Files="$(FieldKitPackageZip)" />

    <MakeDir Directories="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <MakeDir Directories="$(FieldKitPackageRoot)\SPT_Runtime\user\mods\HysocsFieldKit" />

    <Copy SourceFiles="$(FieldKitClientDll)"
          DestinationFolder="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(FieldKitPackageRoot)\SPT_Runtime\user\mods\HysocsFieldKit" />
    <Copy SourceFiles="$(FieldKitLicense)"
          DestinationFolder="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <Copy SourceFiles="$(FieldKitLicense)"
          DestinationFolder="$(FieldKitPackageRoot)\SPT_Runtime\user\mods\HysocsFieldKit" />

    <ZipDirectory SourceDirectory="$(FieldKitPackageRoot)"
                  DestinationFile="$(FieldKitPackageZip)"
                  Overwrite="true" />

    <Message Importance="high"
             Text="FieldKit release package created: $(FieldKitPackageZip)" />
  </Target>
</Project>
