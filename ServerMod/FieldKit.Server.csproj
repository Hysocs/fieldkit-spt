<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>FieldKit.Server</AssemblyName>
    <RootNamespace>FieldKit.Server</RootNamespace>
    <Version>1.0.0</Version>
    <OutputPath>bin\$(Configuration)\FieldKit.Server\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The ZIP is a build output that Visual Studio's fast check cannot
         track, so always let MSBuild evaluate the packaging target. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldKit.csproj"
                      ReferenceOutputAssembly="false" />
    <Reference Include="SemanticVersioning">
      <HintPath>..\..\..\SPT\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>..\..\..\SPT\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>..\..\..\SPT\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>..\..\..\SPT\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <FieldKitServerInstallDir>$(MSBuildProjectDirectory)\..\..\..\SPT\user\mods\HysocsFieldKit</FieldKitServerInstallDir>
    <FieldKitClientDll>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\netstandard2.1\FieldKit.dll</FieldKitClientDll>
    <FieldKitLicense>$(MSBuildProjectDirectory)\..\LICENSE</FieldKitLicense>
    <FieldKitPackageRoot>$(MSBuildProjectDirectory)\..\dist\FieldKit-$(Version)</FieldKitPackageRoot>
    <FieldKitPackageZip>$(MSBuildProjectDirectory)\..\dist\FieldKit-$(Version).zip</FieldKitPackageZip>
  </PropertyGroup>

  <Target Name="DeployFieldKitServerMod"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(FieldKitServerInstallDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(FieldKitServerInstallDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateFieldKitReleasePackage"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release' and '$(SkipPackage)' != 'true'">
    <RemoveDir Directories="$(FieldKitPackageRoot)" />
    <Delete Files="$(FieldKitPackageZip)" />

    <MakeDir Directories="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <MakeDir Directories="$(FieldKitPackageRoot)\SPT\user\mods\HysocsFieldKit" />

    <Copy SourceFiles="$(FieldKitClientDll)"
          DestinationFolder="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(FieldKitPackageRoot)\SPT\user\mods\HysocsFieldKit" />
    <Copy SourceFiles="$(FieldKitLicense)"
          DestinationFolder="$(FieldKitPackageRoot)\BepInEx\plugins\Hysocs-FieldKit" />
    <Copy SourceFiles="$(FieldKitLicense)"
          DestinationFolder="$(FieldKitPackageRoot)\SPT\user\mods\HysocsFieldKit" />

    <ZipDirectory SourceDirectory="$(FieldKitPackageRoot)"
                  DestinationFile="$(FieldKitPackageZip)"
                  Overwrite="true" />

    <Message Importance="high"
             Text="FieldKit release package created: $(FieldKitPackageZip)" />
  </Target>
</Project>
